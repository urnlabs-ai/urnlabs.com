---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Fractional CTO & Technical Advisory',
    statement: "A CTO's judgment, without the full-time hire.",
    description:
      'Technology strategy, architecture standards and security posture. We advise from the developer standup to the board meeting, for companies that need senior technical judgment without a full-time hire.',
    deliverables: [
      'architecture reviews',
      'security posture',
      'roadmap and vendor selection',
      'board reporting',
    ],
  },
  {
    title: 'Cloud & Platform Engineering',
    statement: 'Multi-cloud Kubernetes that stays boring.',
    description:
      'Multi-cloud Kubernetes on EKS, OKE and GKE, Terraform infrastructure as code, and cloud cost optimization. We migrate workloads between clouds without downtime.',
    deliverables: [
      'EKS, OKE, GKE',
      'Terraform IaC',
      'cloud cost optimization',
      'zero-downtime migration',
    ],
  },
  {
    title: 'AI Deployment & Automation',
    statement: 'AI systems that survive contact with production.',
    description:
      'RAG assistants and Azure OpenAI integrations, vLLM and GPU inference serving, and ML platform add-ons running on the Kubernetes clusters you already operate.',
    deliverables: [
      'RAG assistants',
      'Azure OpenAI',
      'vLLM GPU inference',
      'ML platform on Kubernetes',
    ],
  },
];

const metrics = [
  { value: '$15-20K', label: 'monthly cloud savings delivered' },
  { value: '10B+', label: 'messages per year kept running' },
  { value: '~40', label: 'apps migrated AWS to OCI, zero downtime' },
];

const toolkit = [
  'Terraform and Pulumi',
  'Kamaji hosted control planes',
  'Istio and Envoy',
  'Kafka, Redis, PostgreSQL, Cassandra',
  'GitHub Actions and ArgoCD',
  'Prometheus and Grafana',
  'Azure OpenAI and vLLM',
  'SOC 2, HIPAA, GDPR, PCI DSS',
];
---

<Base
  title="URN Labs · Cloud, Kubernetes and AI engineering"
  description="URN Labs is a Lahore-based engineering studio for cloud, Kubernetes and AI infrastructure. Fractional CTO services, platform engineering and AI deployment."
>
  <header class="sticky top-0 z-20 px-4">
    <div
      class="mx-auto mt-5 flex h-12 w-fit items-center gap-4 whitespace-nowrap rounded-full border border-hairline bg-[#161616]/90 px-4 backdrop-blur sm:gap-6 sm:px-6"
    >
      <a href="/" class="font-semibold tracking-tight">URN Labs</a>
      <nav class="flex items-center gap-4 text-xs text-muted sm:gap-6 sm:text-sm">
        <a href="#services" class="transition-colors hover:text-text">Services</a>
        <a href="#products" class="transition-colors hover:text-text">Products</a>
      </nav>
      <a
        href="#contact"
        class="btn rounded-full border border-hairline px-4 py-1.5 text-sm text-text hover:border-accent"
      >
        Contact
      </a>
    </div>
  </header>

  <main id="top">
    <section class="hero-atmos -mt-[68px] flex min-h-[88dvh] flex-col justify-center pt-[68px]">
      <div class="wrap pt-24 pb-24">
        <h1
          class="max-w-6xl font-display text-6xl font-semibold tracking-[-0.03em] leading-[0.95] text-balance md:text-7xl"
        >
          Cloud, Kubernetes and AI engineering for companies that <span class="text-accent">cannot afford downtime</span>.
        </h1>
        <p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-muted">
          URN Labs is a Lahore-based engineering studio led by a working CTO. We run the infrastructure behind billion-message platforms, then build our own products.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="mailto:hello@urnlabs.com"
            class="btn rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg hover:opacity-90"
          >
            Start a conversation
          </a>
          <a
            href="#services"
            class="btn rounded-full border border-hairline px-6 py-3 text-sm font-medium text-text hover:border-accent"
          >
            Explore services
          </a>
        </div>
      </div>
    </section>

    <section class="border-y border-hairline">
      <div class="wrap grid grid-cols-1 md:grid-cols-3">
        {metrics.map((m, i) => (
          <div class:list={['px-8 py-12', i > 0 && 'border-t border-hairline md:border-t-0 md:border-l']}>
            <div class="w-10 border-t-2 border-accent"></div>
            <p class="mt-6 font-display text-5xl font-medium tabular-nums tracking-tight text-text md:text-6xl">{m.value}</p>
            <p class="mt-3 text-sm text-muted">{m.label}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="services" class="scroll-mt-24">
      <div class="wrap pt-20">
        {services.map((s) => (
          <div class="grid grid-cols-1 gap-8 border-t border-hairline py-16 md:grid-cols-12">
            <div class="md:col-span-7">
              <p class="text-xs uppercase tracking-[0.14em] text-accent">{s.title}</p>
              <h2 class="mt-5 max-w-[22ch] font-display text-3xl font-medium tracking-tight leading-[1.05] md:text-5xl">{s.statement}</h2>
            </div>
            <div class="md:col-span-4 md:col-start-9">
              <p class="leading-relaxed text-muted">{s.description}</p>
              <ul class="mt-6 space-y-1.5 font-mono text-xs text-text/70">
                {s.deliverables.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-hairline">
      <div class="wrap grid grid-cols-1 gap-6 py-24 md:grid-cols-12">
        <h2 class="text-sm text-muted md:col-span-3">How we work</h2>
        <div class="md:col-span-9">
          <p class="font-display text-2xl md:text-4xl font-medium leading-[1.15] max-w-3xl">
            A senior engineer does the work. No handoffs, no layers between you and the person writing the code.
          </p>
          <p class="mt-6 text-lg text-muted max-w-[60ch] leading-relaxed">
            We have shipped under SOC 2, HIPAA, GDPR and PCI DSS constraints, and the Kubernetes work is covered by CKAD certification. Engagements start with the systems you already run, not a greenfield re-architecture.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-hairline">
      <div class="wrap py-24">
        <h2 class="text-sm text-muted">Also in the toolkit</h2>
        <ul class="mt-10 grid grid-cols-1 gap-x-12 gap-y-4 font-display text-2xl font-medium leading-[1.2] md:grid-cols-2 md:text-3xl">
          {toolkit.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <section id="products" class="scroll-mt-24 border-t border-hairline">
      <div class="wrap py-24">
        <h2 class="font-display text-3xl font-medium tracking-tight">From the lab</h2>
        <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-muted">
          We build microSaaS tools and Android apps from the same infrastructure playbook. First releases are in development; write to <a href="mailto:hello@urnlabs.com" class="text-text underline-offset-4 hover:underline">hello@urnlabs.com</a> to hear when they ship.
        </p>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 border-t border-hairline">
      <div class="wrap py-24">
        <h2 class="text-sm text-muted">Work with us</h2>
        <a
          href="mailto:hello@urnlabs.com"
          class="mt-6 inline-block break-all font-display text-4xl font-medium tracking-tight text-text underline-offset-8 hover:underline md:text-6xl"
        >
          hello@urnlabs.com
        </a>
        <div class="mt-10 flex flex-col gap-2 text-sm text-muted">
          <a
            href="https://linkedin.com/in/usman-ramzan"
            rel="me noopener"
            class="w-fit transition-colors hover:text-text"
          >
            linkedin.com/in/usman-ramzan
          </a>
          <p>Lahore, Pakistan · working remotely</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="overflow-hidden border-t border-hairline">
    <div class="wrap flex flex-col gap-4 pt-10 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-muted">© 2026 URN Labs</p>
      <nav class="flex gap-6 text-sm text-muted">
        <a href="#services" class="transition-colors hover:text-text">Services</a>
        <a href="#products" class="transition-colors hover:text-text">Products</a>
        <a href="#contact" class="transition-colors hover:text-text">Contact</a>
      </nav>
    </div>
    <p
      aria-hidden="true"
      class="mt-6 -mb-[0.14em] select-none whitespace-nowrap px-5 font-display text-[18vw] font-semibold leading-none tracking-[-0.05em] text-wordmark md:px-8"
    >
      URN Labs
    </p>
  </footer>
</Base>
