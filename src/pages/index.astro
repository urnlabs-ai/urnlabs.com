---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Fractional CTO & Technical Advisory',
    description:
      'Technology strategy, architecture standards and security posture. We advise from the developer standup to the board meeting, for companies that need senior technical judgment without a full-time hire.',
    deliverables: [
      'architecture reviews',
      'security posture',
      'roadmap and vendor selection',
      'board reporting',
    ],
  },
  {
    title: 'Cloud & Platform Engineering',
    description:
      'Multi-cloud Kubernetes on EKS, OKE and GKE, Terraform infrastructure as code, and cloud cost optimization. We migrate workloads between clouds without downtime.',
    deliverables: [
      'EKS, OKE, GKE',
      'Terraform IaC',
      'cloud cost optimization',
      'zero-downtime migration',
    ],
  },
  {
    title: 'AI Deployment & Automation',
    description:
      'RAG assistants and Azure OpenAI integrations, vLLM and GPU inference serving, and ML platform add-ons running on the Kubernetes clusters you already operate.',
    deliverables: [
      'RAG assistants',
      'Azure OpenAI',
      'vLLM GPU inference',
      'ML platform on Kubernetes',
    ],
  },
];

// Orbital SVG geometry. viewBox 640x400, center (320,200).
const CX = 320;
const CY = 200;
const rings = [
  { rx: 120, ry: 48, rot: -12 },
  { rx: 200, ry: 80, rot: 18 },
  { rx: 290, ry: 116, rot: -6 }, // spinning ring, no nodes
];
// Nodes sit on the two static rings so their labels stay upright.
const nodes = [
  { ring: 0, t: 20, label: 'EKS' },
  { ring: 0, t: 160, label: 'OKE' },
  { ring: 0, t: 275, label: 'GKE' },
  { ring: 1, t: 10, label: 'OCI' },
  { ring: 1, t: 80, label: 'AZURE' },
  { ring: 1, t: 150, label: 'GCP' },
  { ring: 1, t: 215, label: 'VLLM' },
  { ring: 1, t: 300, label: 'KAFKA' },
].map((n) => {
  const r = rings[n.ring];
  const t = (n.t * Math.PI) / 180;
  const a = (r.rot * Math.PI) / 180;
  const x0 = r.rx * Math.cos(t);
  const y0 = r.ry * Math.sin(t);
  const x = CX + x0 * Math.cos(a) - y0 * Math.sin(a);
  const y = CY + x0 * Math.sin(a) + y0 * Math.cos(a);
  return { x: x.toFixed(1), y: y.toFixed(1), label: n.label, below: y > CY };
});
---

<Base
  title="URN Labs · Cloud, Kubernetes and AI engineering"
  description="URN Labs is a Lahore-based engineering studio for cloud, Kubernetes and AI infrastructure. Fractional CTO services, platform engineering and AI deployment."
>
  <header class="sticky top-0 z-20 px-4">
    <div
      class="mx-auto mt-5 flex h-12 w-fit items-center gap-6 whitespace-nowrap rounded-full border border-hairline bg-[#161616]/90 px-6 backdrop-blur"
    >
      <a href="/" class="font-semibold tracking-tight">URN Labs</a>
      <nav class="hidden items-center gap-6 text-sm text-muted sm:flex">
        <a href="#services" class="transition-colors hover:text-text">Services</a>
        <a href="#products" class="transition-colors hover:text-text">Products</a>
      </nav>
      <a
        href="#contact"
        class="btn rounded-full border border-hairline px-4 py-1.5 text-sm text-text hover:border-accent"
      >
        Contact
      </a>
    </div>
  </header>

  <main id="top">
    <section class="hero-wash -mt-[68px] pt-[68px]">
      <div class="wrap pt-24 pb-16 md:pt-36 md:pb-24">
        <h1 class="max-w-4xl text-4xl font-medium tracking-tighter leading-[1.05] md:text-6xl">
          Cloud, Kubernetes and AI engineering for companies that <span class="text-accent">cannot afford downtime</span>.
        </h1>
        <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-muted">
          URN Labs is a Lahore-based engineering studio led by a working CTO. We run the infrastructure behind billion-message platforms, then build our own products.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="mailto:hello@urnlabs.com"
            class="btn rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg hover:opacity-90"
          >
            Start a conversation
          </a>
          <a
            href="#services"
            class="btn rounded-full border border-hairline px-6 py-3 text-sm font-medium text-text hover:border-accent"
          >
            Explore services
          </a>
        </div>

        <svg
          class="mx-auto mt-16 w-full max-w-[640px] overflow-visible md:mt-24"
          viewBox="0 0 640 400"
          role="img"
          aria-label="Orbital diagram of the platforms URN Labs operates"
        >
          <defs>
            <radialGradient id="core">
              <stop offset="0%" stop-color="#bbf7d0" />
              <stop offset="55%" stop-color="#34d399" />
              <stop offset="100%" stop-color="#34d399" stop-opacity="0" />
            </radialGradient>
            <filter id="blur" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="40" />
            </filter>
          </defs>

          <circle class="orbit-glow" cx={CX} cy={CY} r="60" fill="#34d399" opacity="0.5" filter="url(#blur)" />

          {rings.slice(0, 2).map((r) => (
            <ellipse
              cx={CX}
              cy={CY}
              rx={r.rx}
              ry={r.ry}
              transform={`rotate(${r.rot} ${CX} ${CY})`}
              fill="none"
              stroke="#26262a"
              stroke-width="1"
            />
          ))}
          <g class="orbit-spin">
            <g transform={`rotate(${rings[2].rot} ${CX} ${CY})`}>
              <ellipse cx={CX} cy={CY} rx={rings[2].rx} ry={rings[2].ry} fill="none" stroke="#26262a" stroke-width="1" />
            </g>
          </g>

          <circle cx={CX} cy={CY} r="28" fill="url(#core)" />

          {nodes.map((n) => (
            <g>
              <circle cx={n.x} cy={n.y} r="4" fill="#34d399" />
              <text
                x={n.x}
                y={n.below ? Number(n.y) + 18 : Number(n.y) - 10}
                text-anchor="middle"
                fill="#9ca3af"
                font-family="Geist Mono Variable, ui-monospace, monospace"
                font-size="11"
              >
                {n.label}
              </text>
            </g>
          ))}
        </svg>
      </div>
    </section>

    <section class="pb-20 md:pb-28">
      <div class="wrap grid grid-cols-1 gap-4 md:grid-cols-12">
        <div class="rounded-lg border border-hairline bg-elevated p-6 md:col-span-6">
          <p class="font-mono text-4xl tracking-tight md:text-5xl">$15-20<span class="text-accent">K</span></p>
          <p class="mt-3 text-sm leading-relaxed text-muted">monthly cloud savings delivered</p>
        </div>
        <div class="rounded-lg border border-hairline bg-elevated p-6 md:col-span-3">
          <p class="font-mono text-4xl tracking-tight md:text-5xl">10<span class="text-accent">B+</span></p>
          <p class="mt-3 text-sm leading-relaxed text-muted">messages per year kept running</p>
        </div>
        <div class="rounded-lg border border-hairline bg-elevated p-6 md:col-span-3">
          <p class="font-mono text-4xl tracking-tight md:text-5xl"><span class="text-accent">~</span>40</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">apps migrated AWS to OCI, zero downtime</p>
        </div>
      </div>
    </section>

    <section id="services" class="scroll-mt-24 border-t border-hairline">
      <div class="wrap py-20 md:py-28">
        <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Services</h2>
        <div class="mt-12 border-t border-hairline">
          {services.map((s) => (
            <div class="grid grid-cols-1 gap-6 border-b border-hairline py-10 md:grid-cols-12 md:gap-8">
              <h3 class="text-xl font-medium tracking-tight md:col-span-4">{s.title}</h3>
              <div class="md:col-span-5">
                <p class="max-w-[65ch] leading-relaxed text-muted">{s.description}</p>
              </div>
              <ul class="space-y-1.5 font-mono text-[13px] leading-snug text-muted md:col-span-3">
                {s.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
        <h2 class="text-2xl font-medium tracking-tight md:col-span-4 md:text-3xl">How we work</h2>
        <div class="md:col-span-7 md:col-start-6">
          <p class="max-w-[65ch] leading-relaxed text-muted">
            A senior engineer does the work. No handoffs, no layers between you and the person writing the code. We have shipped under SOC 2, HIPAA, GDPR and PCI DSS constraints, and the Kubernetes work is covered by CKAD certification. Engagements start with the systems you already run, not a greenfield re-architecture.
          </p>
        </div>
      </div>
    </section>

    <section id="products" class="scroll-mt-24 border-t border-hairline">
      <div class="wrap py-20 md:py-28">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Products</p>
        <h2 class="mt-4 text-2xl font-medium tracking-tight md:text-3xl">From the lab</h2>
        <p class="mt-4 max-w-[65ch] leading-relaxed text-muted">
          We build microSaaS tools and Android apps from the same infrastructure playbook.
        </p>
        <ul class="mt-10 border-t border-hairline">
          <!-- TODO: replace with real product when launched -->
          <li class="flex items-baseline justify-between border-b border-hairline py-4">
            <span class="font-mono text-sm">TBD-1</span>
            <span class="text-sm text-muted">In development</span>
          </li>
          <!-- TODO: replace with real product when launched -->
          <li class="flex items-baseline justify-between border-b border-hairline py-4">
            <span class="font-mono text-sm">TBD-2</span>
            <span class="text-sm text-muted">In development</span>
          </li>
        </ul>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 border-t border-hairline">
      <div class="wrap py-20 md:py-28">
        <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Work with us</h2>
        <a
          href="mailto:hello@urnlabs.com"
          class="mt-8 inline-block break-all text-2xl tracking-tight text-accent underline-offset-4 hover:underline md:text-4xl"
        >
          hello@urnlabs.com
        </a>
        <div class="mt-6">
          <a
            href="https://linkedin.com/in/usman-ramzan"
            rel="me noopener"
            class="text-sm text-muted transition-colors hover:text-accent"
          >
            linkedin.com/in/usman-ramzan
          </a>
        </div>
        <p class="mt-16 font-mono text-sm text-muted">Lahore, Pakistan · working remotely</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-hairline">
    <div class="wrap flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-muted">© 2026 URN Labs</p>
      <nav class="flex gap-6 text-sm text-muted">
        <a href="#services" class="transition-colors hover:text-accent">Services</a>
        <a href="#products" class="transition-colors hover:text-accent">Products</a>
        <a href="#contact" class="transition-colors hover:text-accent">Contact</a>
      </nav>
    </div>
  </footer>
</Base>
